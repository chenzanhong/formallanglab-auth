server:
  port: 8082
  metrics_port: 9092
  pprof_port: 6062
  enable_trace: false
  env: "development"

jwt:
  key: "your-jwt-secret-key-2024"
  access_token_expire_time: 3600
  refresh_token_expire_time: 86400

pg:
  host: localhost
  port: 5432
  name: formallanglab
  user: postgres
  password: "your-postgres-password"

redis:
  host: localhost
  port: 6379
  password: "your-redis-password"
  db: 0
  max_conn: 10
  max_idle_conn: 5

rate:
  user_rate: 100
  user_burst: 200

kafka:
  brokers: localhost:9092
  topic: auth-logs

log:
  level: info
  output: console
  format: json
  file_path: logs/app.log
  max_size: 100
  max_backups: 5
  max_age: 30
  compress: true
  sampling: false
